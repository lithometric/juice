{
  "fps": 30,
  "crf": 16,
  "auto_slowmo": true,
  "animate": true,
  "grade": "eq=contrast=1.06:saturation=1.0,curves=master='0/0 0.25/0.23 0.75/0.77 1/1'",
  "font": {
    "path": "/System/Library/Fonts/HelveticaNeue.ttc",
    "index": 1,
    "size": 54,
    "line_height": 66,
    "color": [
      255,
      255,
      255
    ]
  },
  "text_stroke": 0,
  "text_fade_s": 0,
  "music_fade_out_s": 0,
  "music_gain_under_speech": 0.25,
  "edge_fade_s": 0.03,
  "loudness": {
    "I": -14,
    "TP": -1.5,
    "LRA": 11
  },
  "safe_zones": {
    "_note": "Fractions of the frame kept clear of app UI. Portrait is the strictest of TikTok, Reels and Shorts so one export posts everywhere; landscape is the broadcast title-safe margin.",
    "portrait": {
      "top": 0.12,
      "bottom": 0.22,
      "side": 0.04,
      "buttons": {
        "left": 0.85,
        "top": 0.45,
        "bottom": 0.85
      }
    },
    "landscape": {
      "top": 0.06,
      "bottom": 0.08,
      "side": 0.05,
      "buttons": null
    }
  },
  "lengths": {
    "_note": "Applied before style.json and the spec's style. short = up to ~3 min, built to stop a scroll; long = anything longer, built to hold attention.",
    "short": {
      "hook": {
        "check": true,
        "window": 1.5,
        "speech_by": 0.4,
        "text_by": 0.5,
        "max_words": 10,
        "require_spoken": "auto"
      }
    },
    "long": {
      "hook": {
        "check": true,
        "window": 8.0,
        "speech_by": 1.5,
        "text_by": 3.0,
        "max_words": 12,
        "require_spoken": "auto"
      }
    }
  }
}
